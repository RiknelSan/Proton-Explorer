{
  "name": "proton-explorer",
  "productName": "Proton Explorer",
  "version": "2.0.1",
  "description": "A dual-pane explorer app made on electron",
  "main": "main.js",
  "author": {
    "name": "Riknel",
    "email": "riknel@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.comfyexplorer.app",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "maintainer": "Riknel <riknel@users.noreply.github.com>",
      "synopsis": "Dual-pane media explorer",
      "desktop": {
        "Name": "Proton Explorer",
        "Comment": "Dual-pane media explorer",
        "Categories": "Utility;FileManager;"
      }
    }
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "24.9.1"
  }
}